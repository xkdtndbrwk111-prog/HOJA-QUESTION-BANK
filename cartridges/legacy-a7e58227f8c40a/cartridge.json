      ],
      "provenance": {
        "inputFormat": "skill-v1",
        "originalGroupId": "legacy-a7e58227f8c40a:q_0006",
        "sourceBundleId": "q_0006",
        "sourceRow": 7
      },
      "answer": {
        "text": "바늘"
