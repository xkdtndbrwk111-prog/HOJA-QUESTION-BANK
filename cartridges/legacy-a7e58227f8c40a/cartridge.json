      "provenance": {
        "inputFormat": "skill-v1",
        "originalGroupId": "legacy-a7e58227f8c40a:q_0007",
        "sourceBundleId": "q_0007",
        "sourceRow": 8
      },
      "answer": {
        "text": "병"
