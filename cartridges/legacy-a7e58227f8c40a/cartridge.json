      ],
      "provenance": {
        "inputFormat": "skill-v1",
        "originalGroupId": "legacy-a7e58227f8c40a:q_0005",
        "sourceBundleId": "q_0005",
        "sourceRow": 6
      },
      "answer": {
        "text": "빗"
      }
    },
    {
      "questionId": "legacy-a7e58227f8c40a:7",
      "type": "SHORT",
      "content": [
        {
          "kind": "text",
          "text": "눈이 하나 있지만 아무것도 볼 수 없어요. 무엇일까요?"
