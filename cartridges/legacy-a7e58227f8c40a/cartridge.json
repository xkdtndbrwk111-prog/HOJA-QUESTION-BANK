      ],
      "provenance": {
        "inputFormat": "skill-v1",
        "originalGroupId": "legacy-a7e58227f8c40a:q_0009",
        "sourceBundleId": "q_0009",
        "sourceRow": 10
      },
      "answer": {
        "text": "메아리"
