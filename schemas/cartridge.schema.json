{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"urn:hoja:qb1:cartridge:draft.1",
 "type":"object","additionalProperties":false,
 "required":["schemaVersion","cartridgeId","revision","title","metadata","reviewStatus","questions"],
 "properties":{"schemaVersion":{"const":"qb1-draft.1"},"cartridgeId":{"type":"string","minLength":1},"revision":{"type":"integer","minimum":1},"title":{"type":"string","minLength":1},"metadata":{"type":"object"},"reviewStatus":{"const":"pending"},"questions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/question"}}},
 "$defs":{
  "text":{"type":"string","minLength":1},
  "block":{"oneOf":[
   {"type":"object","additionalProperties":false,"required":["kind","text"],"properties":{"kind":{"const":"text"},"text":{"$ref":"#/$defs/text"}}},
   {"type":"object","additionalProperties":false,"required":["kind","src","alt"],"properties":{"kind":{"const":"image"},"src":{"type":"string","pattern":"^assets/[A-Za-z0-9_./-]+\\.(webp|svg)$"},"alt":{"$ref":"#/$defs/text"}}},
   {"type":"object","additionalProperties":false,"required":["kind","period","labels","marks"],"properties":{"kind":{"const":"frequency"},"period":{"$ref":"#/$defs/text"},"labels":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}},"marks":{"type":"array","minItems":1,"items":{"type":"boolean"}}}},
   {"type":"object","additionalProperties":false,"required":["kind","lines"],"properties":{"kind":{"const":"dialogue"},"lines":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["speaker","text"],"properties":{"speaker":{"$ref":"#/$defs/text"},"text":{"$ref":"#/$defs/text"}}}}}}
  ]},
  "blocks":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/block"}},
  "question":{"type":"object","additionalProperties":false,"required":["questionId","type","content","answer","provenance"],"properties":{"questionId":{"$ref":"#/$defs/text"},"groupId":{"$ref":"#/$defs/text"},"type":{"enum":["MCQ","OX","SHORT"]},"content":{"$ref":"#/$defs/blocks"},"answer":{"type":"object"},"choices":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"object","additionalProperties":false,"required":["id","content"],"properties":{"id":{"$ref":"#/$defs/text"},"content":{"$ref":"#/$defs/blocks"}}}},"explanation":{"type":"string"},"acceptedAnswers":{"type":"array","items":{"type":"string"}},"fractionMode":{"enum":["auto","explicit"]},"answerForm":{"const":"representation"},"provenance":{"type":"object"}},"allOf":[
   {"if":{"properties":{"type":{"const":"MCQ"}}},"then":{"required":["choices"],"properties":{"answer":{"type":"object","additionalProperties":false,"required":["choiceId"],"properties":{"choiceId":{"$ref":"#/$defs/text"}}}}}},
   {"if":{"properties":{"type":{"const":"OX"}}},"then":{"not":{"required":["choices"]},"properties":{"answer":{"type":"object","additionalProperties":false,"required":["value"],"properties":{"value":{"type":"boolean"}}}}}},
   {"if":{"properties":{"type":{"const":"SHORT"}}},"then":{"not":{"required":["choices"]},"properties":{"answer":{"type":"object","additionalProperties":false,"required":["text"],"properties":{"text":{"$ref":"#/$defs/text"}}}}}}
  ]}
 }
}
